using System;
class Program
{
    static int ContarPositivos(int[,] matriz)
    {
        int contador = 0;
        for (int i = 0; i < matriz.GetLength(0); i++)
        {
            for (int j = 0; j < matriz.GetLength(1); j++)
            {
                if (matriz[i, j] > 0)
                {
                    contador++;
                }
            }
        }
        return contador;
    }
    static void Main(string[] args)
    {
        int[,] matriz =
        {
            {-1, 2, 3},
            {-4, 5, -6},
            {7, -8, 9}
        };
        Console.WriteLine("Cantidad de positivos: " + ContarPositivos(matriz));
    }
}
