using System;
class Program
{
    static int SumarMatriz(int[,] matriz)
    {
        int suma = 0;
        for (int i = 0; i < matriz.GetLength(0); i++)
        {
            for (int j = 0; j < matriz.GetLength(1); j++)
            {
                suma += matriz[i, j];
            }
        }
        return suma;
    }

    static void Main(string[] args)
    {
        int[,] matriz =
        {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };
        Console.WriteLine("La suma es: " + SumarMatriz(matriz));
    }
}
